# Fixed 8/16-byte binary sort must retain unsigned byte ordering, NULL handling,
# complete second-word comparisons and the original variable-width fallback.
SET NAMES utf8mb4;
--disable_warnings
DROP TABLE IF EXISTS fts_sort_fixed_binary;
--enable_warnings
CREATE TABLE fts_sort_fixed_binary(id INT PRIMARY KEY, k VARBINARY(32), second_key VARBINARY(16));
INSERT INTO fts_sort_fixed_binary VALUES
(1,NULL,NULL),
(2,X'',X''),
(3,X'00',X'00'),
(4,X'00000000000000',X'0000000000000000'),
(5,X'0000000000000000',X'0000000000000000'),
(6,X'0000000000000001',X'0000000000000001'),
(7,X'0100000000000000',X'0100000000000000'),
(8,X'7F00000000000000',X'7F00000000000000'),
(9,X'8000000000000000',X'8000000000000000'),
(10,X'FF00000000000000',X'FF00000000000000'),
(11,X'000000000000000000',X'0000000000000000'),
(12,X'000000000000000000000000000000',X'0000000000000000'),
(13,X'00000000000000000000000000000000',X'00000000000000000000000000000000'),
(14,X'00000000000000000000000000000001',X'00000000000000000000000000000001'),
(15,X'00000000000000000100000000000000',X'00000000000000000100000000000000'),
(16,X'00000000000000000000000000000020',X'00000000000000000000000000000020'),
(17,X'00000000000000010000000000000000',X'00000000000000010000000000000000'),
(18,X'01000000000000000000000000000000',X'01000000000000000000000000000000'),
(19,X'80000000000000000000000000000000',X'80000000000000000000000000000000'),
(20,X'0000000000000000000000000000000000',X'00000000000000000000000000000000'),
(21,X'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF',X'FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF'),
(22,X'0000000000000000',X'00000000000000000000000000000020'),
(23,X'0000000000000000',X'00000000000000000000000000000000'),
(24,X'0000000000000000',X'00000000000000000000000000000001'),
(25,X'00000000000000000000000000000000',X'0000000000000020'),
(26,X'00000000000000000000000000000000',X'0000000000000000'),
(27,X'00000000000000000000000000000000',X'0000000000000001'),
(28,NULL,X'FFFFFFFFFFFFFFFF');
SELECT /*+ OPT_PARAM('ENABLE_NEWSORT','false') */ id,HEX(k),HEX(second_key) FROM fts_sort_fixed_binary ORDER BY k,second_key,id;
SELECT /*+ OPT_PARAM('ENABLE_NEWSORT','false') */ id,HEX(k),HEX(second_key) FROM fts_sort_fixed_binary ORDER BY k DESC,second_key DESC,id DESC;
SELECT /*+ OPT_PARAM('ENABLE_NEWSORT','false') */ id,HEX(k),HEX(second_key) FROM fts_sort_fixed_binary ORDER BY second_key,k DESC,id;
SELECT /*+ OPT_PARAM('ENABLE_NEWSORT','false') */ id FROM fts_sort_fixed_binary ORDER BY k,second_key,id LIMIT 9 OFFSET 8;
SELECT /*+ OPT_PARAM('ENABLE_NEWSORT','false') */ id,ROW_NUMBER() OVER(ORDER BY k,second_key,id) AS rn FROM fts_sort_fixed_binary ORDER BY id;
DROP TABLE fts_sort_fixed_binary;
