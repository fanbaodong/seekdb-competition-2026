3	1.132911
8	2.265822
select id from fts_predicate_only where match(content) against('alpha beta')
order by match(content) against('alpha beta') desc, id limit 3;
id
8
1
2
select id from fts_predicate_only where match(content) against('alpha beta') > 0.5 order by id;
id
1
2
3
8
select count(*) as no_hits from fts_predicate_only where match(content) against('nonexistentword');
no_hits
0
select count(*) as empty_hits from fts_predicate_only where match(content) against('');
empty_hits
0
select count(*) as null_hits from fts_predicate_only where match(content) against(null);
null_hits
0
select id from fts_predicate_only where match(content) against('+alpha -delta' in boolean mode) order by id;
id
1
8
select id from fts_predicate_only where match(content) against('alpha beta')
or match(content) against('gamma delta') > 0.5 order by id;
id
1
2
3
4
8
10
select id from fts_predicate_only force index(primary)
where id > 1 and match(content) against('alpha beta') order by id;
id
2
3
8
prepare fts_threshold from 'select id from fts_predicate_only where match(content) against(?) > ? order by id';
set @fts_words='alpha beta', @fts_threshold=0;
execute fts_threshold using @fts_words, @fts_threshold;
id
1
2
3
8
set @fts_threshold=0.5;
execute fts_threshold using @fts_words, @fts_threshold;
id
1
2
3
8
deallocate prepare fts_threshold;
prepare fts_presence from 'select id from fts_predicate_only where match(content) against(?) order by id';
set @fts_words='alpha beta';
execute fts_presence using @fts_words;
id
1
2
3
8
set @fts_words='nonexistentword';
execute fts_presence using @fts_words;
id
set @fts_words=null;
execute fts_presence using @fts_words;
id
set @fts_words='delta';
execute fts_presence using @fts_words;
id
2
4
10
deallocate prepare fts_presence;
update fts_predicate_only set content='omega' where id=1;
delete from fts_predicate_only where id=2;
select id from fts_predicate_only where match(content) against('alpha beta') order by id;
id
