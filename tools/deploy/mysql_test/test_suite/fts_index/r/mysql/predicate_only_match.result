drop table if exists fts_predicate_only;
create table fts_predicate_only(id int primary key, content text,
fulltext index ft(content) with parser beng);
insert into fts_predicate_only values
(1,'alpha beta gamma'),(2,'alpha alpha delta'),(3,'beta epsilon'),
(4,'gamma delta'),(5,null),(6,''),(7,'the and a'),(8,'ALPHA beta'),
(9,'omega theta'),(10,'delta epsilon');
select id from fts_predicate_only where match(content) against('alpha beta') order by id;
id
1
2
3
8
select count(*) as hits from fts_predicate_only where match(content) against('alpha beta');
hits
4
select /*+ opt_param('ROWSETS_MAX_ROWS', 0) */ id from fts_predicate_only
where match(content) against('alpha beta') order by id;
id
1
2
3
8
select /*+ opt_param('ROWSETS_MAX_ROWS', 1) */ id from fts_predicate_only
where match(content) against('alpha beta') order by id;
id
1
2
3
8
select /*+ opt_param('ROWSETS_MAX_ROWS', 32) */ id from fts_predicate_only
where match(content) against('alpha beta') order by id;
id
1
2
3
8
select id from fts_predicate_only where match(content) against('alpha beta') > 0 order by id;
id
1
2
3
8
select id from fts_predicate_only where match(content) against('alpha alpha beta') order by id;
id
1
2
3
8
select id from fts_predicate_only where match(content) against('alpha beta') and id > 2 order by id;
id
3
8
select id from fts_predicate_only where match(content) against('alpha beta') order by id limit 2 offset 1;
id
2
3
select count(*) as limited_hits from
(select id from fts_predicate_only where match(content) against('alpha beta') limit 2) t;
limited_hits
2
select id, round(match(content) against('alpha beta'), 6) as score
from fts_predicate_only where match(content) against('alpha beta') order by id;
id	score
