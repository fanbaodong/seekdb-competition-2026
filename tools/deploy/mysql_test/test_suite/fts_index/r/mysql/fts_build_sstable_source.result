UPDATE fts_batch_sstable_docs SET content='alpha delta' WHERE id=0;
DELETE FROM fts_batch_sstable_docs WHERE id=2;
SELECT COUNT(*) AS content_documents_after_dml FROM fts_batch_sstable_docs WHERE MATCH(content) AGAINST('alpha');
content_documents_after_dml
800
ALTER TABLE fts_batch_sstable_docs DROP INDEX ft_all;
ALTER TABLE fts_batch_sstable_docs ADD FULLTEXT INDEX ft_all(title,content) WITH PARSER ik;
SELECT COUNT(*) AS all_documents_rebuilt FROM fts_batch_sstable_docs WHERE MATCH(title,content) AGAINST('database');
all_documents_rebuilt
