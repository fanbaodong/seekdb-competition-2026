create table presence_sorted_heap(id int, content text, fulltext index ft(content) with parser beng);
insert into presence_sorted_heap select * from presence_sorted_runs order by id;
select /*+ opt_param('ROWSETS_MAX_ROWS',1) */ count(*),sum(id),sum(id*id),bit_xor(id)
from presence_sorted_heap where match(content) against('alpha beta gamma');
count(*)	sum(id)	sum(id*id)	bit_xor(id)
193	18721	2415009	1
select /*+ opt_param('ROWSETS_MAX_ROWS',7) */ count(*),sum(id),sum(id*id),bit_xor(id)
from presence_sorted_heap where match(content) against('alpha beta gamma');
count(*)	sum(id)	sum(id*id)	bit_xor(id)
193	18721	2415009	1
select /*+ opt_param('ROWSETS_MAX_ROWS',128) */ count(*),sum(id),sum(id*id),bit_xor(id)
from presence_sorted_heap where match(content) against('alpha beta gamma');
count(*)	sum(id)	sum(id*id)	bit_xor(id)
193	18721	2415009	1
prepare presence_sorted_stmt from 'select count(*) from (select id from presence_sorted_runs where match(content) against(?) limit ? offset ?) v';
set @presence_sorted_words='alpha beta',@presence_sorted_limit=65,@presence_sorted_offset=64;
execute presence_sorted_stmt using @presence_sorted_words,@presence_sorted_limit,@presence_sorted_offset;
count(*)
65
set @presence_sorted_words='alpha',@presence_sorted_limit=32,@presence_sorted_offset=31;
execute presence_sorted_stmt using @presence_sorted_words,@presence_sorted_limit,@presence_sorted_offset;
count(*)
32
set @presence_sorted_words='missingword',@presence_sorted_limit=32,@presence_sorted_offset=0;
execute presence_sorted_stmt using @presence_sorted_words,@presence_sorted_limit,@presence_sorted_offset;
count(*)
0
deallocate prepare presence_sorted_stmt;
start transaction;
update presence_sorted_runs set content='gamma' where id in (1,64,128,160);
delete from presence_sorted_runs where id in (65,129,192);
insert into presence_sorted_runs values(196,'alpha beta');
select /*+ opt_param('ROWSETS_MAX_ROWS',7) */ count(*),sum(id),sum(id*id),bit_xor(id)
from presence_sorted_runs where match(content) against('alpha beta');
count(*)	sum(id)	sum(id*id)	bit_xor(id)
186	17985	2312365	101
select count(*),sum(id),sum(id*id),bit_xor(id) from presence_sorted_runs
where content like '%alpha%' or content like '%beta%';
count(*)	sum(id)	sum(id*id)	bit_xor(id)
186	17985	2312365	101
rollback;
select /*+ opt_param('ROWSETS_MAX_ROWS',128) */ count(*),sum(id),sum(id*id),bit_xor(id)
from presence_sorted_runs where match(content) against('alpha beta');
count(*)	sum(id)	sum(id*id)	bit_xor(id)
192	18528	2377760	192
drop table presence_sorted_heap;
drop table presence_sorted_runs;
drop table presence_sorted_digits;
