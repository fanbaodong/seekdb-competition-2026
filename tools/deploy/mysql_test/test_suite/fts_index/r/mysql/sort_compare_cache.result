SET NAMES utf8mb4;
DROP TABLE IF EXISTS fts_sort_cache;
CREATE TABLE fts_sort_cache(id INT PRIMARY KEY, p INT, c1 VARCHAR(8), c2 VARCHAR(8), c3 VARCHAR(8), c4 VARCHAR(8), c5 VARCHAR(8), c6 VARCHAR(8), c7 VARCHAR(8), c8 VARCHAR(8), v VARCHAR(64) COLLATE utf8mb4_general_ci, b VARBINARY(8), KEY idx_p(p));
INSERT INTO fts_sort_cache(id,p,v,b) VALUES(1,0,NULL,NULL),(2,1,'',UNHEX('')),(3,2,' ',UNHEX('00')),(4,0,'a',UNHEX('0000')),(5,1,'A',UNHEX('20')),(6,2,'a ',UNHEX('0020')),(7,0,'a',UNHEX('6100')),(8,1,'A  ',UNHEX('61')),(9,2,'a',UNHEX('610000')),(10,0,'résumé',UNHEX('ff')),(11,1,'RESUME',UNHEX('ffff')),(12,2,'数据库',UNHEX('0001')),(13,0,'数据',UNHEX('01')),(14,1,'😀',UNHEX('0100')),(15,2,'a😀',UNHEX('7f')),(16,0,'ß',UNHEX('80')),(17,1,'ss',UNHEX('8000')),(18,2,'Á',UNHEX('8020')),(19,0,UNHEX('6100'),UNHEX('61')),(20,1,UNHEX('612000'),UNHEX('6100')),(21,2,NULL,UNHEX('00')),(22,0,'Alpha',NULL),(23,1,'ALPHA ',UNHEX('00')),(24,2,'alpha',UNHEX('0000'));
UPDATE fts_sort_cache SET c1='x',c2='x ',c3='X',c4=NULL,c5='',c6=' ',c7='y',c8='Y';
