prepare presence_batch_stmt from 'select count(*) from (select id from presence_batch_union where match(content) against(?) limit ? offset ?) v';
set @presence_words='alpha beta gamma',@presence_limit=8,@presence_offset=31;
execute presence_batch_stmt using @presence_words,@presence_limit,@presence_offset;
count(*)
8
set @presence_words='nonexistentword',@presence_limit=8,@presence_offset=0;
execute presence_batch_stmt using @presence_words,@presence_limit,@presence_offset;
count(*)
0
set @presence_words='alpha',@presence_limit=1000,@presence_offset=0;
execute presence_batch_stmt using @presence_words,@presence_limit,@presence_offset;
count(*)
93
deallocate prepare presence_batch_stmt;
start transaction;
update presence_batch_union set content='unrelatedword' where mod(id,13)=0;
delete from presence_batch_union where mod(id,17)=0;
insert into presence_batch_union values(300,'alpha beta'),(301,'gamma');
