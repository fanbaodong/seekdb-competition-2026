select count(*),sum(id),sum(id*id) from presence_batch_union
where content like '%alpha%' or content like '%beta%' or content like '%gamma%';
count(*)	sum(id)	sum(id*id)
141	18732	3296604
rollback;
select count(*),sum(id),sum(id*id) from presence_batch_union
where match(content) against('alpha beta gamma');
count(*)	sum(id)	sum(id*id)
160	20560	3515024
create table presence_batch_binary(id varbinary(32) primary key, content text,
fulltext index ft(content) with parser beng);
insert into presence_batch_binary values
(x'00','alpha'),(x'0000','alpha beta'),(x'0020','beta'),(x'20','gamma'),
(x'2020','alpha gamma'),(x'6100','alpha beta gamma'),(x'6120','beta gamma'),
(x'7F','alpha'),(x'80','beta'),(x'FF','gamma'),(x'FF00','alpha beta');
select /*+ opt_param('ROWSETS_MAX_ROWS',2) */ hex(id) from presence_batch_binary
where match(content) against('alpha beta gamma') order by id;
