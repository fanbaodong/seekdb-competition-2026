CREATE TABLE encoded_fts_binary(id INT PRIMARY KEY, content TEXT COLLATE utf8mb4_bin);
INSERT INTO encoded_fts_binary VALUES(1,'Alpha alpha BETA beta'),(2,'résumé RESUME 数据库'),(3,NULL),(4,''),(5,'数据库全文检索 数据库'),(6,CONCAT('alpha',CHAR(0),' beta'));
ALTER TABLE encoded_fts_binary ADD FULLTEXT INDEX ft(content) WITH PARSER beng;
SELECT id, ROUND(MATCH(content) AGAINST('alpha beta'),12) AS score FROM encoded_fts_binary WHERE MATCH(content) AGAINST('alpha beta') ORDER BY id;
id	score
1	1.944557387646
6	1.747473868628
CREATE TABLE encoded_fts_fallback(id INT PRIMARY KEY, content TEXT COLLATE utf8mb4_unicode_ci);
INSERT INTO encoded_fts_fallback SELECT * FROM encoded_fts_binary;
ALTER TABLE encoded_fts_fallback ADD FULLTEXT INDEX ft(content) WITH PARSER beng;
SELECT id, ROUND(MATCH(content) AGAINST('alpha beta'),12) AS score FROM encoded_fts_fallback WHERE MATCH(content) AGAINST('alpha beta') ORDER BY id;
id	score
1	1.944557387646
6	1.747473868628
DROP TABLE encoded_fts_docs;
DROP TABLE encoded_fts_binary;
DROP TABLE encoded_fts_fallback;
DROP TABLE encoded_fts_digits;
